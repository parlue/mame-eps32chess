# Vorlaeufiges Entwicklungsprofil (MUSS auf echter Hardware bestaetigt werden).
# Angenommen: 16 MB Flash, 8 MB PSRAM. Nicht als Zielausstattung von
# "Bauer Rigno" behaupten - siehe docs/07_hardware_profile.md.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_SPIRAM=y
# CONFIG_SPIRAM_MODE_QUAD is not set
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=n
# Haupt-Task-Stack: MAMEs Aufbauphase (Adressraeume, ROM-Laden, Geraetebau)
# nutzt tiefe Template-Aufrufketten. 16 KB waren fuer den Kern zu knapp
# angesetzt, 32 KB sind der erste Wert mit Reserve.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=32768
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_TASK_WDT_TIMEOUT_S=20
# C++-Ausnahmen sind fuer MAME 0.220 zwingend (emumem/emu core werfen).
CONFIG_COMPILER_CXX_EXCEPTIONS=y
CONFIG_COMPILER_CXX_EXCEPTIONS_EMG_POOL_SIZE=0
# RTTI an: MAME delegate.h nutzt typeid in einem Fehlerpfad
CONFIG_COMPILER_CXX_RTTI=y
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

CONFIG_SPIRAM_MODE_OCT=y

# CONFIG_SPIRAM_SPEED_40M is not set

CONFIG_SPIRAM_SPEED_80M=y

CONFIG_SPIRAM_SPEED=80

CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096

# CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_160 is not set

CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=240

# CONFIG_ESP32S3_DEFAULT_CPU_FREQ_160 is not set

CONFIG_ESP32S3_DEFAULT_CPU_FREQ_240=y

CONFIG_ESP32S3_DEFAULT_CPU_FREQ_MHZ=240

# CONFIG_ESP_CONSOLE_UART_DEFAULT is not set

CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG is not set

# CONFIG_CONSOLE_UART_DEFAULT is not set

# CONFIG_FATFS_LFN_NONE is not set

CONFIG_FATFS_LFN_HEAP=y
